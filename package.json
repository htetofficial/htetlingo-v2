{
  "name": "htetlingo-v2",
  "version": "2.0.0",
  "private": true,
  "description": "HtetLingo — Learn Languages. Understand Words. Connect Cultures.",
  "scripts": {
    "dev:web": "pnpm --filter @htetlingo/web dev",
    "build:web": "pnpm --filter @htetlingo/web build",
    "dev:site": "pnpm --filter @htetlingo/site dev",
    "build:site": "pnpm --filter @htetlingo/site build",
    "build:all": "pnpm build:web && pnpm build:site",
    "data:build": "python3 packages/data-pipeline/build_ornagai.py"
  }
}
